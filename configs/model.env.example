# Runtime and model identity
# Defaults to the uv-managed project environment; override only when needed.
# PYTHON_BIN=/path/to/environment/bin/python
MODEL_ID=/path/to/checkpoint/or/huggingface/model-id
MODEL_SLUG=model-name
GPU_IDS=0,1
VISUALIZATION_GPU=0
TRUST_REMOTE_CODE=false

# Storage roots
RESULTS_ROOT=results
DATASET_ROOT=data/dataset
CALIBRATION_CONCEPTS_JSON=data/dataset/simple_1000_concepts.json
LOGS_ROOT=logs/auto_workflow
TMP_ROOT=tmp/auto_workflow

# Shared experiment settings
SEED=42
DTYPE=bfloat16
PROMPT_PREAMBLE=system
PROMPT_TEMPLATE=semantic_highinj_posref_gate_balanced_disrupts
NUM_CHOICES=10
POSITION_INDEX_START=0
SCALE_MODE=relative_hidden_norm
BATCH_SIZE=64
EXTRACTION_BATCH_SIZE=16

# Stage-00 layer/strength grid
SWEEP_LAYER_START=0
SWEEP_LAYER_END=auto
SWEEP_LAYER_STEP=1
SWEEP_STRENGTHS="1 2 3 4 5 6 7 8"

# Optional consistency assertions after Stage 00. Leave blank to load the
# selected values directly from results/<model>/calibration/selection.json.
INJECTION_LAYER=
INJECTION_STRENGTH=

# GPUs for the gate and router stages; comma-separated GPUs run data parallel.
STE_GPU=0

# Gate-head search window, e.g. 17-23: from the layer where the position--none
# separation of Stage 02b begins to rise to the layer before the Stage 01
# position-clustering transition.
STE_LAYERS=

# Router heads: the transition layer (largest rise in Stage 01 K-means accuracy)
# and the heads there whose clean-output patch lowers correct-position accuracy
# most in the Stage 08 head-wise sweep. Space-separated head indices.
ROUTER_LAYER=
ROUTER_HEADS=

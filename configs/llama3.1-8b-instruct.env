# Defaults to the uv-managed project environment; override only when needed.
# PYTHON_BIN=/path/to/environment/bin/python
MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
MODEL_SLUG=llama3.1-8b-instruct
GPU_IDS=4,5,6,7
VISUALIZATION_GPU=7

RESULTS_ROOT=results
DATASET_ROOT=data/dataset
CALIBRATION_CONCEPTS_JSON=data/dataset/simple_1000_concepts.json
LOGS_ROOT=logs/auto_workflow
TMP_ROOT=tmp/auto_workflow

SEED=42
DTYPE=bfloat16
PROMPT_PREAMBLE=system
PROMPT_TEMPLATE=semantic_highinj_posref_gate_balanced_disrupts
NUM_CHOICES=10
POSITION_INDEX_START=0
SCALE_MODE=relative_hidden_norm
BATCH_SIZE=32
EXTRACTION_BATCH_SIZE=16
TRUST_REMOTE_CODE=false

SWEEP_LAYER_START=0
SWEEP_LAYER_END=all
SWEEP_LAYER_STEP=1
SWEEP_STRENGTHS="1 2 3 4 5 6 7 8"

INJECTION_LAYER=0
INJECTION_STRENGTH=6.0

STE_GPU=0

# Gate-head search window: from where the position--none split rises (Stage
# 02b) to the layer before the position-clustering transition (Stage 01).
STE_LAYERS=13-16
# Transition layer and its router heads (Stage 08 head-wise patching).
ROUTER_LAYER=17
ROUTER_HEADS=24
